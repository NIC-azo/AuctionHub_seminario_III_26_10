{
  "name": "AuctionHub",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 5173, 5432, 9000, 9001, 8080, 9090, 3001],
  "portsAttributes": {
    "3000": { "label": "AuctionHub API" },
    "5173": { "label": "AuctionHub frontend" },
    "5432": { "label": "PostgreSQL" },
    "9001": { "label": "MinIO console" },
    "9090": { "label": "Prometheus" },
    "3001": { "label": "Grafana" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
