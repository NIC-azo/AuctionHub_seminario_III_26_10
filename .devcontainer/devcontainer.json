{
  "name": "AuctionHub",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 5173, 5433, 9000, 9001, 8081, 9090, 3001],
  "portsAttributes": {
    "3000": { "label": "AuctionHub API" },
    "5173": { "label": "AuctionHub frontend" },
    "5433": { "label": "PostgreSQL" },
    "8081": { "label": "cAdvisor" },
    "9001": { "label": "MinIO console" },
    "9090": { "label": "Prometheus" },
    "3001": { "label": "Grafana" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
